# Auth / DB
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; see clients.ts allowed call sites
DATABASE_URL_SERVICE=                 # workers only

# Domains
NEXT_PUBLIC_PLATFORM_HOST=yourplatform.com
INTERNAL_API_URL=
INTERNAL_API_KEY=

# Token vault (32 bytes base64: `openssl rand -base64 32`)
TOKEN_VAULT_KEY=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=notifications@yourplatform.com

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=                           # server/worker processes (same value, not NEXT_PUBLIC_)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                    # for source map upload in CI

# AI providers (unset => visible "Coming soon", never fake success)
# Text generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=                       # also used by OpenAI TTS
GOOGLE_AI_API_KEY=                    # Gemini text

# Image generation
STABILITY_API_KEY=
IDEOGRAM_API_KEY=

# Video generation
RUNWAY_API_KEY=
LUMA_API_KEY=

# Audio generation
ELEVENLABS_API_KEY=

# Billing (Stripe — https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=                # whsec_... from Stripe webhook endpoint
STRIPE_PRICE_EDITION_MAP={}           # JSON: { "price_xxx": "edition-uuid", ... }

# Social OAuth apps
META_APP_ID=
META_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
